{
  "manifest_version": 3,
  "name": "show-and-tell",
  "version": "1.2.20775.836",
  "description": "Side panel for guided demos driven by an AI agent (next/back/questions, page markings, recordings) plus on-page highlights.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "sidePanel", "tabs", "webNavigation", "debugger", "tabCapture", "offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["vendor/m3-tokens.css"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true }
  ],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Open the show-and-tell panel" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["gestures.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
