// Merge into ~/.config/opencode/opencode.json(c). Replace <skill> with the absolute skill path.
// Keep an existing "playwright" server as it is: that is the agent's private browser. An older
// "playwright-demo" entry (port 9334) can go: show-and-tell offers those browser_* tools itself.
{
  "mcp": {
    // Bridge between the agent and the side panel; owns 127.0.0.1:47613, starts the shared browser and
    // drives it through Playwright MCP (browser_* tools).
    "show-and-tell": {
      "type": "local",
      "command": ["node", "<skill>/bridge/index.js"],
      "enabled": true
    }
  }
}
